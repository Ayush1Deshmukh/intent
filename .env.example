DATABASE_URL="postgresql://user:pass@host:5432/verified_tape"
AUTH_SECRET="dev-secret-change-me-in-production-0123456789abcdef"
DEMO_RESET_TOKEN="demo-reset"
MAX_TAPE_ROWS="5000"

# --- AI (optional) -----------------------------------------------------------
# Every AI feature has a deterministic fallback, so AI_ENABLED="false" is a fully
# working demo. To see the model itself, pick a provider with a free tier:
#
#   groq        https://console.groq.com/keys        no card, ~14,400 requests/day
#   gemini      https://aistudio.google.com/apikey   no card, daily caps by model
#   openrouter  https://openrouter.ai/keys           models with a :free suffix
#   cerebras    https://cloud.cerebras.ai/           no card
#   ollama      https://ollama.com/download          local, no key, no internet
#
# AI_MODEL is optional — each provider has a current default. `npm run ai:models`
# lists what your key can actually reach.
AI_ENABLED="false"
AI_PROVIDER="groq"
AI_API_KEY=""
AI_MODEL=""
AI_BASE_URL=""
