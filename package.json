    "dry-run": "tsx scripts/dry-run.ts",
    "ui:smoke": "node scripts/ui/smoke.mjs",
    "ui:flow": "node scripts/ui/flow.mjs",
    "ui:demo": "node scripts/ui/demo.mjs",
